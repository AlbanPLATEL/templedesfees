APP_NAME="La Chatterie du Temple des Fées"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=templedesfees
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="letempledesfees@outlook.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Destinataire des demandes de pre-reservation
ELEVAGE_MAIL=letempledesfees@outlook.fr

# Compte du back-office, cree par le seed. Sans mot de passe ici, il en
# tire un au hasard et l affiche une seule fois.
BACK_OFFICE_EMAIL=letempledesfees@outlook.fr
BACK_OFFICE_MOT_DE_PASSE=php

# L acompte. Les clefs Stripe de TEST suffisent pour montrer le parcours.
ACOMPTE_CENTIMES=30000
ACOMPTE_DELAI_JOURS=7
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAIEMENT_DEMONSTRATION=false
